                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Authentication response has the required fields and types\", function () {",
                  "  pm.expect(body).to.have.all.keys(\"accessToken\", \"tokenType\", \"expiresIn\");",
                  "  pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.tokenType).to.equal(\"Bearer\");",
                  "  pm.expect(body.expiresIn).to.be.a(\"number\").and.above(0);",
                  "});",
                  "pm.collectionVariables.set(\"token\", body.accessToken);"

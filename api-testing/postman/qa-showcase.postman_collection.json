        {
          "name": "API-TASK-002 create a valid high-priority task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "const taskSchema = {",
                  "  type: \"object\",",
                  "  required: [\"id\", \"title\", \"priority\", \"completed\", \"createdAt\", \"updatedAt\"],",
                  "  properties: {",
                  "    id: { type: \"string\", pattern: \"^TASK-[0-9]+$\" },",
                  "    title: { type: \"string\" },",
                  "    priority: { enum: [\"low\", \"medium\", \"high\"] },",
                  "    completed: { type: \"boolean\" },",
                  "    createdAt: { type: \"string\" },",
                  "    updatedAt: { type: \"string\" }",
                  "  }",
                  "};",
                  "pm.test(\"Created resource matches schema and submitted values\", function () {",
                  "  pm.expect(body.data).to.have.jsonSchema(taskSchema);",
                  "  pm.expect(body.data.title).to.equal(\"Review API contract\");",
                  "  pm.expect(body.data.priority).to.equal(\"high\");",
                  "  pm.expect(body.data.completed).to.equal(false);",
                  "});",
                  "pm.collectionVariables.set(\"taskId\", body.data.id);"
                ]
              }
            }

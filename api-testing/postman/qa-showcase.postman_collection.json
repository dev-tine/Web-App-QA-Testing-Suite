      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set(\"requestStartedAt\", Date.now());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"API-CT-001 response includes a request ID\", function () {",
          "  pm.expect(pm.response.headers.has(\"X-Request-Id\")).to.be.true;",
          "  pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.match(/^REQ-\\d{4}$/);",
          "});",
          "",
          "pm.test(\"API-CT-002 response time is below one second\", function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(1000);",
          "});",
          "",
          "if (pm.response.code !== 204) {",
          "  pm.test(\"API-CT-003 non-empty response is JSON\", function () {",
          "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
          "    pm.expect(function () { pm.response.json(); }).not.to.throw();",
          "  });",
          "}"
        ]
      }
    }
  ],
